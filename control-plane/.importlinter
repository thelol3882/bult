[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:apps-independent]
name = The apps domain knows nothing about deploys, nodes or metrics
type = forbidden
source_modules =
    app.apps
forbidden_modules =
    app.deploys
    app.nodes
    app.metrics

[importlinter:contract:nodes-independent]
name = The nodes domain knows nothing about apps, deploys, metrics, agents or ingress
type = forbidden
source_modules =
    app.nodes
forbidden_modules =
    app.apps
    app.deploys
    app.metrics
    app.agents
    app.ingress
# Allowed: a router reaches app.core.deps (which wires agents and ingress) through auth.deps.
allow_indirect_imports = True

[importlinter:contract:agents-independent]
name = The agents client knows no domain (it asks a Directory protocol)
type = forbidden
source_modules =
    app.agents
forbidden_modules =
    app.apps
    app.deploys
    app.nodes
    app.metrics
    app.auth

[importlinter:contract:deploys-use-nodes-via-facade]
name = Deploys reach the nodes domain only through its facade and public.py
type = forbidden
source_modules =
    app.deploys
forbidden_modules =
    app.nodes.deps
    app.nodes.repositories
    app.nodes.routers
    app.nodes.schemas
    app.nodes.uow
    app.nodes.models
    app.nodes.services.nodes
    app.nodes.services.monitor
    app.nodes.services.tokens
allow_indirect_imports = True

[importlinter:contract:deploys-use-apps-via-facade]
name = Deploys reach the apps domain only through its facade and public.py
type = forbidden
source_modules =
    app.deploys
forbidden_modules =
    app.apps.deps
    app.apps.repositories
    app.apps.services.apps
    app.apps.routers
    app.apps.schemas
# Allowed: app.apps.services.facade (types) and app.apps.public (Depends provider).
# deploys -> facade -> services.apps is the intended path, so indirect imports are fine.
allow_indirect_imports = True

[importlinter:contract:metrics-use-other-domains-via-facade]
name = Metrics reach the apps and deploys domains only through their facades and public.py
type = forbidden
source_modules =
    app.metrics
forbidden_modules =
    app.apps.deps
    app.apps.repositories
    app.apps.services.apps
    app.apps.routers
    app.apps.schemas
    app.deploys.deps
    app.deploys.repositories
    app.deploys.services.deploys
    app.deploys.services.worker
    app.deploys.services.runner
    app.deploys.routers
    app.deploys.schemas
    app.deploys.uow
    app.deploys.models
    app.nodes
ignore_imports =
    app.metrics.tests.test_metrics -> app.deploys.uow
allow_indirect_imports = True

[importlinter:contract:domains-use-auth-in-routers-only]
name = Apps, deploys and nodes know auth only in their routers (CurrentUser); services get a Principal
type = forbidden
source_modules =
    app.apps
    app.deploys
    app.nodes
    app.metrics
forbidden_modules =
    app.auth
ignore_imports =
    app.metrics.routers.metrics -> app.auth.deps
    app.nodes.routers.nodes -> app.auth.deps
    app.apps.routers.apps -> app.auth.deps
    app.deploys.routers.deploys -> app.auth.deps
    app.deploys.routers.lifecycle -> app.auth.deps

[importlinter:contract:auth-independent]
name = The auth domain knows nothing about apps, deploys, nodes or metrics
type = forbidden
source_modules =
    app.auth
forbidden_modules =
    app.apps
    app.deploys
    app.nodes
    app.metrics

[importlinter:contract:routers-skip-repositories]
name = Routers never import repositories
type = forbidden
source_modules =
    app.apps.routers
    app.deploys.routers
    app.nodes.routers
    app.metrics.routers
forbidden_modules =
    app.apps.repositories
    app.deploys.repositories
    app.nodes.repositories
    app.metrics.repositories
# routers -> deps -> repositories is wiring, not data access.
allow_indirect_imports = True

[importlinter:contract:no-web-framework-in-core-logic]
name = Services, repositories, errors and the event bus know nothing about FastAPI/Starlette
type = forbidden
source_modules =
    app.apps.services
    app.deploys.services
    app.auth.services
    app.nodes.services
    app.metrics.services
    app.core.errors
    app.core.events
    app.apps.repositories
    app.deploys.repositories
    app.auth.repositories
    app.nodes.repositories
    app.metrics.repositories
forbidden_modules =
    fastapi
    starlette

[importlinter:contract:handlers-wired-in-main]
name = Event handlers of deploys are imported only by main (subscriptions live in one place)
type = forbidden
source_modules =
    app.apps
    app.agents
    app.ingress
    app.health
    app.core
    app.deploys.routers
    app.deploys.services
    app.deploys.deps
    app.deploys.repositories
    app.deploys.schemas
forbidden_modules =
    app.deploys.handlers
allow_indirect_imports = True

[importlinter:contract:event-bus-knows-no-domain]
name = core.events must not import domains
type = forbidden
source_modules =
    app.core.events
forbidden_modules =
    app.apps
    app.deploys
    app.agents
    app.ingress

[importlinter:contract:handlers-call-services-only]
name = Deploys event handlers are entry points like routers and call services only
type = forbidden
source_modules =
    app.deploys.handlers
forbidden_modules =
    app.deploys.repositories
    app.agents
    app.ingress
allow_indirect_imports = True

[importlinter:contract:services-know-no-sqlalchemy]
name = Services, errors, handlers and the event bus know ports only, not sqlalchemy
type = forbidden
source_modules =
    app.apps.services
    app.deploys.services
    app.auth.services
    app.nodes.services
    app.metrics.services
    app.core.events
    app.core.errors
    app.deploys.handlers
    app.metrics.handlers
forbidden_modules =
    sqlalchemy
# services -> uow -> sql repositories is wiring; only direct imports are forbidden.
allow_indirect_imports = True
